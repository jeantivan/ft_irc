+
+void Server::dezombify()
+{
+    std::map<int, Client>::iterator it = clients_.begin();
+    while (it != clients_.end())
+    {
+        int fd = it->first;
+        bool zombie = it->second.getToDisconnect()
+            && it->second.getToDisconnectSinze() + TEARDOWNTIMEMAX < time(NULL);
+        ++it;
+
+        if (zombie)
+            disconnectClient(fd);
+    }
+}
